"use client";

import {
  useEffect,
  useState,
} from "react";

import {
  getReservationCalendar,
} from "../actions";

import {
  RESERVATION_STATUS_COLORS,
  RESERVATION_STATUS_LABELS,
} from "@/constants/reservations/reservation-status";

interface ReservationCalendarProps {

  restaurantId:string;

  date:string;

}

export function ReservationCalendar({

  restaurantId,

  date,

}:ReservationCalendarProps){


 const [events,setEvents]=
 useState<any[]>([]);


 const [loading,setLoading]=
 useState(true);




 useEffect(()=>{

  load();

 },[
  restaurantId,
  date
 ]);





 async function load(){

  try{

   setLoading(true);

   const data=

   await getReservationCalendar(

    restaurantId,

    date

   );

   setEvents(
    data
   );

  }

  finally{

   setLoading(false);

  }

 }






 if(loading){

  return(

   <div
    className="
     rounded-lg
     border
     bg-white
     p-6
    "
   >

    Cargando calendario...

   </div>

  );

 }






 return(

  <div
   className="
    rounded-lg
    border
    bg-white
    divide-y
   "
  >

   {

    events.length===0 && (

     <div
      className="
       p-8
       text-center
       text-gray-500
      "
     >

      No existen reservas para este día.

     </div>

    )

   }






   {

    events.map(event=>(

     <div

      key={
       event.id
      }

      className="
       flex
       items-center
       justify-between
       p-4
      "

     >


      <div>

       <h3
        className="
         font-semibold
        "
       >
        {event.title}
       </h3>


       <p
        className="
         text-sm
         text-gray-500
        "
       >

        {event.start}

        {" - "}

        {event.end}

       </p>


       <p
        className="
         text-sm
         text-gray-500
        "
       >

        Personas:

        {" "}

        {event.guests}

       </p>


      </div>






      <span

       className={`
        rounded-full
        border
        px-3
        py-1
        text-xs
        font-medium

        ${
         RESERVATION_STATUS_COLORS[
          event.status
         ]
        }

       `}

      >

       {

        RESERVATION_STATUS_LABELS[
         event.status
        ]

       }

      </span>





     </div>

    ))

   }

  </div>

 );

}



